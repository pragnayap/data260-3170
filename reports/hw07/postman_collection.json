    {
      "name": "1.1 Login",
      "item": [
        {
          "name": "Login as reader (200 + JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"reader\",\n  \"password\": \"ReaderPass#2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 and token returned\", function(){ pm.response.to.have.status(200); pm.expect(pm.response.json().access_token).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"reader_token\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as writer (200 + JWT)",
