    {
      "name": "1.4 Create",
      "item": [
        {
          "name": "POST /api/incidents as reader (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/incidents",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reader_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incidentCode\": \"{{incident_code}}\",\n  \"routeId\": \"Line 22\",\n  \"location\": \"5th & Main\",\n  \"submitterEmail\": \"lucky@example.com\",\n  \"description\": \"Brake failure reported near the station\",\n  \"category\": \"Mechanical Failure\",\n  \"ridersAffected\": 3,\n  \"relatedRouteId\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"incident_code\", \"INC-3170-\" + (90000 + Math.floor(Math.random()*9999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", function(){ pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
