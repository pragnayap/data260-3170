# Copy to .env and fill in your MySQL password. .env is gitignored.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/s3170_rel

# Session behaviour (optional overrides)
S3170_IDLE_TIMEOUT=1800
S3170_COOKIE_INSECURE=1

# Password for the N+1 measurement account used by code/measure_n1.py
S3170_N1_PASSWORD=choose-a-test-password
